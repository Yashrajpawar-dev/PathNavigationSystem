# ============================================================
# .gitignore — Campus Navigation System
# ============================================================

# Node.js dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production build output (regenerated by: cd frontend && npm run build)
frontend/dist/
frontend/build/

# Compiled C++ binary (regenerated by: build.bat)
campus_nav.exe

# Runtime data files (auto-generated, not source)
dsa-engine/data/blocked_walkways.json

# Environment files
.env
.env.local
.env.production
*.env

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/
*.suo
*.user

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Vite cache
.vite/
frontend/.vite/

# Temporary files
*.tmp
*.log
*.bak

# C++ build artifacts
*.o
*.obj
*.pdb
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
