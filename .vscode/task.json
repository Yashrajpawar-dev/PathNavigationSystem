{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Path Navigation System",
            "type": "shell",
            "command": "if not exist build mkdir build && g++ main.cpp -Iinclude -o build\\PathNavigationSystem.exe",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}